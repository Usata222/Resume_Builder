# Copy this file to .env and fill in real values. .env itself is gitignored
# and should never be committed or pushed to GitHub.

# Generate one with:
# python -c "import secrets,string; c=string.ascii_letters+string.digits+'!@#$%^&*(-_=+)'; print(''.join(secrets.choice(c) for _ in range(50)))"
SECRET_KEY=change-me-to-a-real-secret-key

DEBUG=True

# Comma-separated list of hosts allowed to serve this app, e.g.:
# ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost
